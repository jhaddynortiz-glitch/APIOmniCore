generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Contact {
  id             String       @id @default(uuid())
  phoneNumber    String
  name           String?
  unreadCount    Int          @default(0)
  organizationId String
  createdAt      DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id])
  messages       Message[]
  orders         Order[]

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
}

model Message {
  id        String   @id @default(uuid())
  body      String?
  mediaUrl  String?
  mimeType  String?
  isFromMe  Boolean  @default(false)
  type      String   @default("text")
  contactId String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id])

  @@index([contactId, createdAt])
}

model Organization {
  id                  String             @id
  name                String
  slug                String             @unique
  whatsappToken       String?
  whatsappPhoneId     String?
  whatsappVerifyToken String?
  openaiApiKey        String?
  googleClientId      String?
  googleClientSecret  String?
  logoUrl             String?
  createdAt           DateTime           @default(now())
  Contact             Contact[]
  users               UserOrganization[]
  products            Product[]
  prompts             Prompt[]
  categories          Category[]
  subcategories       Subcategory[]
  isDeliveryEnabled   Boolean            @default(false)
  isLocalEnabled      Boolean            @default(false)
  isMeetingEnabled    Boolean            @default(false)
  deliveryZones       DeliveryZone[]
  storeLocations      StoreLocation[]
  meetingPoints       MeetingPoint[]
  orders              Order[]
  templates           Template[]
  operationContacts   OperationContact[]
  keywordTriggers     KeywordTrigger[]
}

model User {
  id                         String             @id @default(uuid())
  email                      String             @unique
  password                   String?
  googleId                   String?            @unique
  fullName                   String?
  avatarUrl                  String?
  globalRole                 String             @default("NONE")
  lastActiveOrganizationId   String?
  createdAt                  DateTime           @default(now())
  organizations              UserOrganization[]
  operationContacts          OperationContact[]
}

model Category {
  id             String        @id @default(uuid())
  name           String
  organizationId String
  Organization   Organization  @relation(fields: [organizationId], references: [id])
  subcategories  Subcategory[]
  createdAt      DateTime      @default(now())

  @@index([organizationId])
}

model Subcategory {
  id             String       @id @default(uuid())
  name           String
  categoryId     String
  organizationId String
  Category       Category     @relation(fields: [categoryId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
  products       Product[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Product {
  id                String       @id @default(uuid())
  name              String
  description       String?
  price             Float
  imageUrl          String?
  currency          String       @default("Bs")
  stock             Int          @default(0)
  isActive          Boolean      @default(true)
  facebookAdId      String?
  subcategoryId     String?
  Subcategory       Subcategory? @relation(fields: [subcategoryId], references: [id])
  organizationId    String
  Organization      Organization @relation(fields: [organizationId], references: [id])
  createdAt         DateTime     @default(now())
  ads               ProductAd[]
  isDeliveryEnabled Boolean      @default(true)
  isLocalEnabled    Boolean      @default(true)
  isMeetingEnabled  Boolean      @default(true)
  orderItems        OrderItem[]
  triggers          ProductTrigger[]
  cardDescription   String?
  cardImageUrl      String?

  @@index([organizationId])
}

model ProductTrigger {
  id        String   @id @default(uuid())
  keyword   String
  response  String
  productId String
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model OperationContact {
  id             String       @id @default(uuid())
  name           String
  phoneNumber    String
  type           String       // ADMIN or DELIVERY
  userId         String?
  User           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ordersAssigned Order[]      @relation("DeliveryAssignment")
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([userId])
}

model ProductAd {
  id        String   @id @default(uuid())
  adId      String
  platform  String   @default("meta") // meta, tiktok, instagram
  productId String
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([adId])
}

model Prompt {
  id             String       @id @default(uuid())
  name           String
  content        String
  isActive       Boolean      @default(false)
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model UserOrganization {
  userId         String
  organizationId String
  role           String       @default("editor")
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  User           User         @relation(fields: [userId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@id([userId, organizationId])
}

model DeliveryZone {
  id             String           @id @default(uuid())
  city           String
  lat            Float
  lng            Float
  organizationId String
  Organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  radii          DeliveryRadius[]
  createdAt      DateTime         @default(now())

  @@index([organizationId])
}

model DeliveryRadius {
  id             String       @id @default(uuid())
  distanceKm     Float
  price          Float
  deliveryZoneId String
  DeliveryZone   DeliveryZone @relation(fields: [deliveryZoneId], references: [id], onDelete: Cascade)
}

model StoreLocation {
  id             String       @id @default(uuid())
  city           String
  address        String
  description    String?
  lat            Float
  lng            Float
  imageUrl       String?
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model MeetingPoint {
  id             String       @id @default(uuid())
  city           String
  name           String
  address        String?
  schedule       String
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model Order {
  id              String         @id @default(uuid())
  status          String         @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  deliveryMethod  String?        // DELIVERY, LOCAL, MEETING
  deliveryCost    Float          @default(0)
  shippingAddress String?
  lat             Float?
  lng             Float?
  total           Float
  organizationId  String
  Organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId       String
  Contact         Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  storeLocationId String?
  StoreLocation   StoreLocation? @relation(fields: [storeLocationId], references: [id], onDelete: SetNull)
  meetingPointId    String?
  MeetingPoint      MeetingPoint?  @relation(fields: [meetingPointId], references: [id], onDelete: SetNull)
  deliveryContactId String?
  DeliveryContact   OperationContact? @relation("DeliveryAssignment", fields: [deliveryContactId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([organizationId])
  @@index([contactId])
  @@index([deliveryContactId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  Order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  Product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Template {
  id             String       @id @default(uuid())
  name           String
  content        String
  isActive       Boolean      @default(true)
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model KeywordTrigger {
  id             String       @id @default(uuid())
  keyword        String
  response       String
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
